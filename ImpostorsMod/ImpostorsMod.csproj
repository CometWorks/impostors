<Project Sdk="Microsoft.NET.Sdk">
  <!-- This project exists for the IDE and for compile checks only. The game compiles
       the scripts under Mod/Data/Scripts itself when the mod is loaded into a world,
       the DLL built here is never used by the game. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ImpostorsMod</RootNamespace>
    <AssemblyName>ImpostorsMod</AssemblyName>

    <!-- The game compiles mods as .NET Framework, C# 6 code (see MyScriptCompiler).
         The build works on Linux as well, the .NET SDK downloads the reference
         assemblies of .NET Framework as a NuGet package. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>6</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Ensure SDK generates assembly attributes (no need for AssemblyInfo) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- Default configuration if none supplied -->
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Keep original behaviour for post/pre build events -->
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin/Debug/</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin/Release/</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Game assemblies referenced by the mod script compiler of the game
       (see SpaceEngineers.Game.MySpaceGameDefaultIlCompiler.InitIlCompiler).
       Using the same set here keeps the IDE from offering APIs mods cannot use. -->
  <ItemGroup>
    <Reference Include="netstandard">
      <HintPath>$(Bin64Dir)netstandard.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ProtoBuf.Net.Core">
      <HintPath>$(Bin64Dir)ProtoBuf.Net.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Sandbox.Common">
      <HintPath>$(Bin64Dir)Sandbox.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Sandbox.Game">
      <HintPath>$(Bin64Dir)Sandbox.Game.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Sandbox.Graphics">
      <HintPath>$(Bin64Dir)Sandbox.Graphics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SpaceEngineers.Game">
      <HintPath>$(Bin64Dir)SpaceEngineers.Game.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SpaceEngineers.ObjectBuilders">
      <HintPath>$(Bin64Dir)SpaceEngineers.ObjectBuilders.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Collections.Immutable">
      <HintPath>$(Bin64Dir)System.Collections.Immutable.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage">
      <HintPath>$(Bin64Dir)VRage.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Game">
      <HintPath>$(Bin64Dir)VRage.Game.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Input">
      <HintPath>$(Bin64Dir)VRage.Input.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Library">
      <HintPath>$(Bin64Dir)VRage.Library.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Math">
      <HintPath>$(Bin64Dir)VRage.Math.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Render">
      <HintPath>$(Bin64Dir)VRage.Render.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateProps" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Bin64)' == ''"
           Text="Could not locate the Space Engineers Bin64 folder. Set &lt;Bin64&gt; in &quot;$(RepoRoot)Directory.Build.props.user&quot;." />
    <Error Condition="!Exists('$(Bin64)')"
           Text="Invalid Bin64 path &quot;$(Bin64)&quot; in &quot;$(RepoRoot)Directory.Build.props[.user]&quot;." />
    <Warning Condition="'$(Mods)' == ''"
             Text="Could not locate the local mods folder of the game, the mod will not be deployed. Set &lt;Mods&gt; in &quot;$(RepoRoot)Directory.Build.props.user&quot;." />
  </Target>

  <!-- Links the Mod folder of this project into the local mods folder of the game
       (a directory junction on Windows, a symlink on Linux), so the game loads the mod
       straight from the working copy and source changes need no copying at all.
       A stale link (for example after moving the working copy) is recreated, while a
       real folder with the same name is left untouched. -->
  <Target Name="DeployMod" AfterTargets="Build"
          Condition="'$(RunPostBuildEvent)' != 'Never' And '$(Mods)' != ''">
    <PropertyGroup>
      <ModSourceDir>$(MSBuildProjectDirectory)$(PathSeparator)Mod</ModSourceDir>
      <ModLinkDir>$(Mods)$(PathSeparator)Impostors</ModLinkDir>

      <!-- Links and junctions carry the ReparsePoint attribute, real folders do not -->
      <ModLinkAttributes Condition="Exists('$(ModLinkDir)')">$([System.IO.File]::GetAttributes('$(ModLinkDir)'))</ModLinkAttributes>
      <ModFolderExists>false</ModFolderExists>
      <ModFolderExists Condition="'$(ModLinkAttributes)' != '' And !$(ModLinkAttributes.Contains('ReparsePoint'))">true</ModFolderExists>
    </PropertyGroup>

    <MakeDir Condition="!$(ModFolderExists)" Directories="$(Mods)" />

    <!-- Windows: rmdir removes only the junction itself, never the linked content -->
    <Exec Condition="!$(ModFolderExists) And $([MSBuild]::IsOSPlatform('Windows'))"
          Command="if exist &quot;$(ModLinkDir)&quot; rmdir &quot;$(ModLinkDir)&quot;" />
    <Exec Condition="!$(ModFolderExists) And $([MSBuild]::IsOSPlatform('Windows'))"
          Command="mklink /J &quot;$(ModLinkDir)&quot; &quot;$(ModSourceDir)&quot;" />

    <!-- Linux: ln -sfn replaces an existing symlink in place -->
    <Exec Condition="!$(ModFolderExists) And !$([MSBuild]::IsOSPlatform('Windows'))"
          Command="ln -sfn &quot;$(ModSourceDir)&quot; &quot;$(ModLinkDir)&quot;" />

    <Message Condition="!$(ModFolderExists)" Importance="high"
             Text="Linked the mod into the local mods folder of the game: &quot;$(ModLinkDir)&quot; -> &quot;$(ModSourceDir)&quot;" />
    <Message Condition="$(ModFolderExists)" Importance="high"
             Text="Local mod folder: &quot;$(ModLinkDir)&quot; (a real folder, not a link, left untouched)" />
  </Target>
</Project>
